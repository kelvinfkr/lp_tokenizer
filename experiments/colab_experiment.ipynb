    "# ── 4. 配置参数（根据 GPU 调整）────────────────────────────\n",
    "import torch\n",
    "\n",
    "def auto_config():\n",
    "    if not torch.cuda.is_available():\n",
    "        return dict(train_mb=2, vocab_size=4096, batch_size=4,\n",
    "                    seq_len=256, num_iters=200, device='cpu')\n",
    "    name = torch.cuda.get_device_name(0)\n",
    "    vram = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "\n",
    "    if vram >= 75:      # A100 80GB\n",
    "        return dict(train_mb=500, vocab_size=50257, batch_size=64,\n",
    "                    seq_len=1024, num_iters=10000, device='cuda')\n",
    "    elif vram >= 35:    # A100 40GB\n",
    "        return dict(train_mb=200, vocab_size=50257, batch_size=32,\n",
    "                    seq_len=1024, num_iters=10000, device='cuda')\n",
    "    elif vram >= 20:    # 4090 24GB or similar\n",
    "        return dict(train_mb=100, vocab_size=50257, batch_size=16,\n",
    "                    seq_len=1024, num_iters=5000, device='cuda')\n",
    "    else:               # T4 / V100 16GB\n",
    "        return dict(train_mb=20, vocab_size=16384, batch_size=8,\n",
    "                    seq_len=512, num_iters=2000, device='cuda')\n",
    "\n",
    "cfg = auto_config()\n",
    "print('Auto config:')\n",
    "for k, v in cfg.items():\n",
    "    print(f'  {k}: {v}')"
   ]

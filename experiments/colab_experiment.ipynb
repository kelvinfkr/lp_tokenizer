   "source": [
    "# ── 10. BPB 生成质量对比 + 可视化 ─────────────────────────\n",
    "import re\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def parse_log(path):\n",
    "    steps, train_losses, val_losses = [], [], []\n",
    "    with open(path) as f:\n",
    "        for line in f:\n",
    "            m = re.search(r'step\\s+(\\d+).*train loss\\s+([\\d.]+)', line)\n",
    "            if m:\n",
    "                steps.append(int(m.group(1)))\n",
    "                train_losses.append(float(m.group(2)))\n",
    "            m2 = re.search(r'val loss\\s+([\\d.]+)', line)\n",
    "            if m2:\n",
    "                val_losses.append(float(m2.group(1)))\n",
    "    return steps, train_losses, val_losses\n",
    "\n",
    "bpe_steps, bpe_train, bpe_val = parse_log('experiments/out/bpe/log.txt')\n",
    "cls_steps, cls_train, cls_val = parse_log('experiments/out/clustering/log.txt')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Training loss\n",
    "axes[0].plot(bpe_steps, bpe_train, label='BPE', color='steelblue')\n",
    "axes[0].plot(cls_steps, cls_train, label='Clustering (MinHash+LSH)', color='darkorange')\n",
    "axes[0].set_xlabel('Step'); axes[0].set_ylabel('Train Loss (nats)')\n",
    "axes[0].set_title('Training Loss'); axes[0].legend(); axes[0].grid(alpha=0.3)\n",
    "\n",
    "# Validation loss → BPB\n",
    "BPE_AVG_BPT = 3.6   # GPT-2 BPE: ~3.6 bytes/token on English\n",
    "CLS_AVG_BPT = 2.8   # clustering: will be estimated after tokenizer training\n",
    "\n",
    "val_steps_bpe = [bpe_steps[i] for i in range(0, len(bpe_steps),\n",
    "                  max(1, len(bpe_steps)//len(bpe_val))) if i < len(bpe_val)]\n",
    "val_steps_cls = [cls_steps[i] for i in range(0, len(cls_steps),\n",
    "                  max(1, len(cls_steps)//len(cls_val))) if i < len(cls_val)]\n",
    "\n",
    "bpe_bpb = [v / np.log(2) / BPE_AVG_BPT for v in bpe_val]\n",
    "cls_bpb = [v / np.log(2) / CLS_AVG_BPT for v in cls_val]\n",
    "\n",
    "axes[1].plot(val_steps_bpe[:len(bpe_bpb)], bpe_bpb,\n",
    "             'o-', label='BPE', color='steelblue')\n",
    "axes[1].plot(val_steps_cls[:len(cls_bpb)], cls_bpb,\n",
    "             's-', label='Clustering (MinHash+LSH)', color='darkorange')\n",
    "axes[1].set_xlabel('Step'); axes[1].set_ylabel('Bits per Byte (↓ better)')\n",
    "axes[1].set_title('Validation BPB (cross-tokenizer fair)'); axes[1].legend(); axes[1].grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('experiments/out/comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "if bpe_val and cls_val:\n",
    "    print(f'\\nFinal results:')\n",
    "    print(f'  BPE        val loss={bpe_val[-1]:.4f}  BPB={bpe_bpb[-1]:.4f}')\n",
    "    print(f'  Clustering val loss={cls_val[-1]:.4f}  BPB={cls_bpb[-1]:.4f}')\n",
    "    diff = cls_bpb[-1] - bpe_bpb[-1]\n",
    "    print(f'  Δ BPB = {diff:+.4f}  ({\"Clustering wins\" if diff < 0 else \"BPE wins\"})')"
   ]

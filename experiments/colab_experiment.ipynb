    "# ── 11. 生成样本对比 ────────────────────────────────────────\n",
    "# 需要安装 transformers 并且 train_gpt2.py 保存了 .pt checkpoint\n",
    "import os, sys\n",
    "sys.path.insert(0, '.')\n",
    "\n",
    "from tokenizer.bpe_baseline import BPETokenizer\n",
    "from tokenizer.clustering_tokenizer import ClusteringTokenizer\n",
    "\n",
    "PROMPT = \"Once upon a time, a little girl named\"\n",
    "\n",
    "# BPE encode\n",
    "bpe = BPETokenizer()\n",
    "print('BPE tokens:', bpe.encode(PROMPT))\n",
    "print('BPE token count:', len(bpe.encode(PROMPT)))\n",
    "\n",
    "# Clustering encode\n",
    "if os.path.exists('data/clustering/tokenizer.bin'):\n",
    "    cls = ClusteringTokenizer()\n",
    "    cls.load('data/clustering/tokenizer.bin')\n",
    "    cls_ids = cls.encode(PROMPT)\n",
    "    print('Clustering tokens:', cls_ids)\n",
    "    print('Clustering token count:', len(cls_ids))\n",
    "    print('Roundtrip:', cls.decode_str(cls_ids) == PROMPT)"
   ]
  }
